<?xml version="1.0" encoding="UTF-8"?>
<entity-facade-xml type="seed">

    <!-- Facet Type Enumeration Type -->
    <moqui.basic.EnumerationType enumTypeId="McpFacetType" description="MCP Resource Facet Types"/>

    <!-- Facet Types -->
    <moqui.basic.Enumeration enumId="McpFacetMeta" enumTypeId="McpFacetType"
                            description="General Metadata" sequenceNum="10"/>
    <moqui.basic.Enumeration enumId="McpFacetTag" enumTypeId="McpFacetType"
                            description="Search &amp; Discovery Tag" sequenceNum="20"/>
    <moqui.basic.Enumeration enumId="McpFacetSecurity" enumTypeId="McpFacetType"
                            description="Security &amp; HIPAA Classification" sequenceNum="30"/>
    <moqui.basic.Enumeration enumId="McpFacetDependency" enumTypeId="McpFacetType"
                            description="Entity / Service Dependency" sequenceNum="40"/>
    <moqui.basic.Enumeration enumId="McpFacetVector" enumTypeId="McpFacetType"
                            description="Vector Embedding Descriptor" sequenceNum="50"/>

    <!-- 1. Define Artifact Group for AGI AI Services & REST -->
    <moqui.security.ArtifactGroup artifactGroupId="AGI_AI_ALL" 
                                  description="AGI AI Services and REST APIs"/>

    <!-- 2. Bind the Services to this Group (Prefix match) -->
    <moqui.security.ArtifactGroupMember artifactGroupId="AGI_AI_ALL" 
                                        artifactTypeEnumId="AtmService" 
                                        artifactName="org.moqui.ai.*" 
                                        nameIsPattern="Y"/>

    <!-- 3. Bind the REST Path to this Group -->
    <moqui.security.ArtifactGroupMember artifactGroupId="AGI_AI_ALL" 
                                        artifactTypeEnumId="AtmRestPath" 
                                        artifactName="/rest/s1/agi-ai.*" 
                                        nameIsPattern="Y"/>

    <!-- 4. Grant All Users Full Access (View, Create, Update, Delete) -->
    <moqui.security.ArtifactAuthz artifactGroupId="AGI_AI_ALL" 
                                  userGroupId="ALL_USERS" 
                                  authzTypeEnumId="AuthzAll" 
                                  authzActionEnumId="AuthzAll"/>
</entity-facade-xml>