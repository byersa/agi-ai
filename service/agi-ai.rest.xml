<?xml version="1.0" encoding="UTF-8"?>
<resource xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/rest-api-3.xsd"
          name="agi-ai" version="s1" require-csrf="false" require-authentication="false">

    <!-- MCP Protocol Endpoints -->
    <resource name="mcp">
        <resource name="resources">
            <method type="get"><service name="org.moqui.ai.mcp.McpResourceServices.get#ResourceList"/></method>
            <resource name="content">
                <method type="get"><service name="org.moqui.ai.mcp.McpResourceServices.get#ResourceContent"/></method>
            </resource>
            <resource name="facet">
                <method type="post"><service name="org.moqui.ai.mcp.McpResourceServices.set#ResourceFacet"/></method>
                <method type="delete"><service name="org.moqui.ai.mcp.McpResourceServices.delete#ResourceFacet"/></method>
            </resource>
        </resource>
        <resource name="tools">
            <method type="get"><service name="org.moqui.ai.mcp.McpToolServices.get#ToolList"/></method>
            <resource name="call">
                <method type="post"><service name="org.moqui.ai.mcp.McpToolServices.call#Tool"/></method>
            </resource>
        </resource>
        <resource name="runService">
            <method type="post"><service name="org.moqui.ai.AgiServiceServices.run#Service"/></method>
        </resource>
    </resource>

    <!-- RAG & Agent Proxy Endpoints -->
    <resource name="preprocessRagContext">
        <method type="post"><service name="org.moqui.ai.AgiRagServices.preprocess#RagContext"/></method>
    </resource>

    <!-- AgiPayload FSM Pipeline Endpoints (Mapped to AgiAiGatewayServices) -->
    <resource name="payload">
        <method type="get"><service name="org.moqui.ai.AgiAiGatewayServices.get#Payload"/></method>
        <method type="post"><service name="org.moqui.ai.AgiAiGatewayServices.process#Payload"/></method>
        <resource name="detail">
            <method type="get"><service name="org.moqui.ai.AgiAiGatewayServices.get#Payload"/></method>
        </resource>
    </resource>
    <resource name="payloads">
        <method type="get"><service name="org.moqui.ai.AgiAiGatewayServices.find#HistoricalPayloads"/></method>
    </resource>

    <!-- Dual-Layer MCP File/DB Synchronization -->
    <resource name="sync">
        <resource name="component">
            <method type="post"><service name="org.moqui.ai.mcp.McpSyncServices.sync#ComponentMcpDirectory"/></method>
        </resource>
        <resource name="exportArtifact">
            <method type="post"><service name="org.moqui.ai.mcp.McpSyncServices.export#ArtifactMcpYaml"/></method>
        </resource>
    </resource>

    <resource name="artifactMetadata">
        <method type="get">
            <service name="org.moqui.ai.mcp.AgiMcpServices.get#ArtifactMetadata"/>
        </method>
    </resource>

    <resource name="discussions">
        <method type="get">
            <service name="org.moqui.ai.discussion.AgiDiscussionServices.get#DiscussionTree"/>
        </method>
        <method type="post">
            <service name="org.moqui.ai.discussion.AgiDiscussionServices.create#Discussion"/>
        </method>

        <!-- Explicit sub-resource alias for /discussions/tree -->
        <resource name="tree">
            <method type="get">
                <service name="org.moqui.ai.discussion.AgiDiscussionServices.get#DiscussionTree"/>
            </method>
        </resource>

        <resource name="transcript">
            <method type="get">
                <service name="org.moqui.ai.discussion.AgiDiscussionServices.get#DiscussionTranscript"/>
            </method>
        </resource>
        <resource name="message">
            <method type="post">
                <service name="org.moqui.ai.discussion.AgiDiscussionServices.record#DiscussionTurn"/>
            </method>
        </resource>
        <resource name="dispatch">
            <method type="post">
                <service name="org.moqui.ai.discussion.AgiDiscussionServices.dispatch#AgentTurn"/>
            </method>
        </resource>
        <resource name="promote">
            <method type="post">
                <service name="org.moqui.ai.discussion.AgiDiscussionServices.promote#DiscussionToWorkEffort"/>
            </method>
        </resource>
        <resource name="spawn-subplans">
            <method type="post">
                <service name="org.moqui.ai.discussion.AgiDiscussionServices.spawn#SubplansFromDecomposition"/>
            </method>
        </resource>
        <resource name="archive-branch">
            <method type="post">
                <service name="org.moqui.ai.pipeline.AgiPipelineServices.archive#PipelineBranch"/>
            </method>
        </resource>
        <resource name="rollback-batch">
            <method type="post">
                <service name="org.moqui.ai.discussion.AgiDiscussionServices.rollback#DiscussionBatch"/>
            </method>
        </resource>
        <resource name="pipeline-graph">
            <method type="get">
                <service name="org.moqui.ai.discussion.AgiDiscussionServices.get#PipelineGraph"/>
            </method>
        </resource>
        <!-- In-Place Title Edit Endpoint -->
        <resource name="title">
            <method type="post">
                <service name="org.moqui.ai.discussion.AgiDiscussionServices.update#DiscussionTitle"/>
            </method>
        </resource>
        <id name="discussionId">
            <method type="delete">
                <service name="org.moqui.ai.discussion.AgiDiscussionServices.delete#Discussion"/>
            </method>

            <!-- Working Directives & component.md Sync Endpoints -->
            <resource name="directives">
                <method type="get">
                    <service name="org.moqui.ai.discussion.AgiDiscussionServices.getOrEnsure#DiscussionDraftPayload"/>
                </method>
                <method type="post">
                    <service name="org.moqui.ai.discussion.AgiDiscussionServices.save#DiscussionDirectives"/>
                </method>
                <resource name="pin">
                    <method type="post">
                        <service name="org.moqui.ai.discussion.AgiDiscussionServices.pin#TurnToDirectives"/>
                    </method>
                </resource>
            </resource>
        </id>
    </resource>
    <!-- First-Class Pipeline Step Endpoints -->
    <resource name="pipeline">
        <resource name="step">
            <resource name="dispatch">
                <method type="post">
                    <service name="org.moqui.ai.pipeline.AgiPipelineServices.recordAndDispatch#PipelineStep"/>
                </method>
            </resource>
            <resource name="fork">
                <method type="post">
                    <service name="org.moqui.ai.pipeline.AgiPipelineServices.fork#PipelineStep"/>
                </method>
            </resource>
            <resource name="archive">
                <method type="post">
                    <service name="org.moqui.ai.pipeline.AgiPipelineServices.archive#PipelineBranch"/>
                </method>
            </resource>
            <!-- 🎯 Binds /pipeline/step/artifact -->
            <resource name="artifact">
                <method type="post">
                    <service name="org.moqui.ai.pipeline.AgiPipelineServices.update#PipelineStepArtifact"/>
                </method>
            </resource>
            <!-- 🎯 Binds /pipeline/step/promote -->
            <resource name="promote">
                <method type="post">
                    <service name="org.moqui.ai.pipeline.AgiPipelineServices.promote#PipelineStepToDiscussion"/>
                </method>
            </resource>
        </resource>
        <resource name="orchestrate">
            <method type="post">
                <service name="org.moqui.ai.pipeline.AgiPipelineServices.orchestrate#Module"/>
            </method>
        </resource>
    </resource>
    <!-- Component Screen Hierarchy & Progress Matrix -->
    <resource name="component-hierarchy">
        <method type="get">
            <service name="org.moqui.ide.AgiIdeServices.get#ComponentScreenHierarchy"/>
        </method>
    </resource>
</resource>